#include <vector>
#include <unordered_map>
using namespace std;

class Solution {
public:
    bool checkSubarraySum(vector<int>& nums, int k) {
        unordered_map<int, int> prefixIndex;
        prefixIndex[0] = -1; // Handle sum from start
        int sum = 0;

        for (int i = 0; i < nums.size(); i++) {
            sum += nums[i];
            int mod = k == 0 ? sum : sum % k;

            if (prefixIndex.find(mod) != prefixIndex.end()) {
                if (i - prefixIndex[mod] >= 2) // subarray length ≥ 2
                    return true;
            } else {
                prefixIndex[mod] = i;
            }
        }

        return false;
    }
};
